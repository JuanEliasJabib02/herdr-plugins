#!/bin/sh
# spotlight: runs the Spotlight CLI (../cli.mjs) on Node. Installed as
# ~/.local/bin/spotlight, a symlink to this file (T7), so it follows its own
# links to find the mod folder. Node: the one on PATH, else Homebrew's.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
mod=$(cd "$(dirname "$self")/.." && pwd -P) || exit 1
node=$(command -v node 2>/dev/null)
if [ -z "$node" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$candidate" ]; then
      node=$candidate
      break
    fi
  done
fi
if [ -z "$node" ]; then
  echo "spotlight: node not found (PATH, /opt/homebrew/bin, /usr/local/bin)" >&2
  exit 127
fi
exec "$node" "$mod/cli.mjs" "$@"
