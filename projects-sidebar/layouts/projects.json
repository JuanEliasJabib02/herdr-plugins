{
  "id": "root",
  "type": "row",
  "theme": "one-dark-pro",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "projects"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "projects-agents"
              }
            }
          ]
        },
        {
          "id": "groups",
          "type": "block",
          "size": {
            "px": 44
          },
          "content": {
            "mod": "projects",
            "props": {
              "view": "groups"
            }
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "explorer",
                  "children": [
                    {
                      "id": "explorer",
                      "type": "block",
                      "content": {
                        "mod": "code-explorer"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "row",
          "resizable": false,
          "size": {
            "px": 28
          },
          "children": [
            {
              "id": "status-workspace",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "status-spotlight",
              "type": "block",
              "size": {
                "px": 40
              },
              "content": {
                "mod": "spotlight",
                "props": {
                  "view": "footer"
                }
              }
            },
            {
              "id": "status-usage",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "claude-accounts",
                "props": {
                  "view": "footer"
                }
              }
            },
            {
              "id": "status-agent-sleep",
              "type": "block",
              "size": {
                "px": 40
              },
              "content": {
                "mod": "agent-sleep"
              }
            }
          ]
        }
      ]
    }
  ],
  "preview": "layouts/projects.svg"
}
