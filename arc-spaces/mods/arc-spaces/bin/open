#!/bin/sh
# open: macOS's open, except for a link clicked in Herdr, which opens in the Arc
# space of its group (the arc-spaces plugin). Herdr runs `open <url>` by name,
# and /usr/local/bin comes before /usr/bin on its PATH, so a link there gets here.
# Everything else on this Mac that runs `open`, and anything that goes wrong,
# ends in the real one.
#
# ARC_SPACES_OPEN, _OSASCRIPT, _HERDR, _HC, _APP, _TIMEOUT and _LOOKUP_TIMEOUT
# are for the tests.

real=${ARC_SPACES_OPEN:-/usr/bin/open}

# A link is one http(s) URL. Every other call goes through before any work.
[ $# -eq 1 ] || exec "$real" "$@"
case $1 in
  http://* | https://*) ;;
  *) exec "$real" "$@" ;;
esac

# Only Herdr's own clicks. Terminals run under herdr-core, so a shell's or an
# agent's `open` has another parent and goes through, as it does in Orca.
parent=$(/bin/ps -o comm= -p "$PPID" 2>/dev/null)
case $parent in
  */Herdr.app/Contents/MacOS/Herdr | */herdr-app) ;;
  *) exec "$real" "$@" ;;
esac

home=${HERDR_APP_HOME:-"$HOME/.config/herdr-app"}

# Off, or no group has a name: nothing to ask Herdr.
jq -e '(.["arc-spaces.v1"] // {}) | .enabled == true and any((.names // {})[]?; type == "string" and test("\\S"))' \
  "$home/shared.json" >/dev/null 2>&1 || exec "$real" "$@"

# Runs a command for at most $1 seconds. A command that can't start fails too.
limit() { /usr/bin/perl -e 'alarm shift; exec { $ARGV[0] } @ARGV or exit 127' "$@"; }

listing=$(limit "${ARC_SPACES_LOOKUP_TIMEOUT:-3}" "${ARC_SPACES_HERDR:-$parent}" ls 2>/dev/null) || exec "$real" "$@"

# Where the shown space is now, as projects-sidebar's placeOf: its first
# terminal with a live folder (herdr-core's record, which Herdr reads), else the
# folder it was made in. A terminal hc can't read is skipped; one that takes too
# long ends the search. A space on another machine has no terminal looked at.
live=
set -f
IFS='
'
for terminal in $(printf '%s\n' "$listing" | jq -r '[.spaces[]? | select(.active == true)][0]
    | select((.machine // null) == null) | .tabs[]?.terminals[]?.terminal | strings' 2>/dev/null); do
  record=$(limit "${ARC_SPACES_LOOKUP_TIMEOUT:-3}" "${ARC_SPACES_HC:-hc}" get "$terminal" 2>/dev/null)
  case $? in
    0)
      live=$(printf '%s\n' "$record" | jq -r '.foreground.cwd // .cwd // empty | strings' 2>/dev/null)
      [ -n "$live" ] && break
      ;;
    142) break ;; # stopped by the limit's SIGALRM
  esac
done
unset IFS
set +f

# The Arc space, or nothing when the group has no name or anything here fails.
# Asked at the click, so it can't be stale: the place gives the project (the
# longest checkout holding it, as projects-sidebar's matchSpaces), the project
# gives the group. A space outside every group, or on another machine, uses the
# active group, as Orca does.
space=$(printf '%s\n' "$listing" | jq -r --arg live "$live" --arg userhome "$HOME" --slurpfile shared "$home/shared.json" '
  # projects-sidebar normPath: forward slashes, no trailing slash ("/" stays).
  def slashes: if type == "string" then gsub("\\\\"; "/") else . end;
  def norm: slashes | if type == "string" and . != "" then (sub("/+$"; "") | if . == "" then "/" else . end) else "" end;
  # Only the place gets ~ expanded (normPath with home, in matchSpaces). Stored
  # paths count only when absolute, as parseRegistry and parseCache keep them.
  def expand: slashes | if type == "string" and $userhome != "" and (. == "~" or startswith("~/")) then ($userhome | norm) + .[1:] else . end;
  def absolute: type == "string" and startswith("/");
  def inside($dir): . == $dir or startswith(if $dir == "/" then "/" else $dir + "/" end);
  $shared[0] as $s
  | ($s["arc-spaces.v1"] // {}) as $config
  | select($config.enabled == true)
  | $s["projects.v1"] as $registry
  | ([.spaces[] | select(.active == true)][0]) as $shown
  | (if ($shown.machine // null) != null then "" elif $live != "" then $live else $shown.folder end | expand | norm) as $at
  | ([($s["projects.cache.v1"] // {}) | objects | to_entries[]
      | select((.key | absolute) and (.value | type == "array" and all(.[]; type == "object" and (.path | absolute))))
      | (.key | norm) as $project | .value[]
      | {project: $project, path: (.path | norm)}
      | select(.path as $path | $at | inside($path))]
     | max_by(.path | length) | .project?) as $project
  | ([$registry.groups[] | select(any(.projects[]?; (.path | absolute) and (.path | norm) == $project))][0].id) as $own
  | ($own // (if any($registry.groups[]; .id == $registry.activeGroup) then $registry.activeGroup else $registry.groups[0].id end)) as $group
  | ($config.names[$group] // "") | gsub("^\\s+|\\s+$"; "")
' 2>/dev/null)
[ -n "$space" ] || exec "$real" "$@"

# A missing app can stop AppleScript on a "Where is Arc?" dialog.
if [ ! -d "${ARC_SPACES_APP:-/Applications/Arc.app}" ] && [ ! -d "$HOME/Applications/Arc.app" ]; then
  exec "$real" "$@"
fi

# Orca's script (src/main/arc-space-url-open.ts). The URL and the name go as
# arguments, so neither can become script text. The limit: the first use waits
# on macOS's Automation prompt, and a hung Arc must not eat the click. As in
# Orca, a click that runs out of time also goes to the real open.
limit "${ARC_SPACES_TIMEOUT:-10}" "${ARC_SPACES_OSASCRIPT:-/usr/bin/osascript}" \
  -e 'on run argv' \
  -e 'set targetUrl to item 1 of argv' \
  -e 'set spaceName to item 2 of argv' \
  -e 'tell application id "company.thebrowser.Browser"' \
  -e 'activate' \
  -e 'tell front window' \
  -e 'tell space spaceName' \
  -e 'focus' \
  -e 'make new tab with properties {URL:targetUrl}' \
  -e 'end tell' \
  -e 'end tell' \
  -e 'end tell' \
  -e 'end run' \
  "$1" "$space" >/dev/null 2>&1 && exit 0

exec "$real" "$@"
