#!/bin/sh
# wake-agent: runs agent-sleep's wake-agent CLI (./wake-agent.mjs, logic in
# ../wake-cli.js) on Node (awake-agent D5). Installed as
# ~/.local/bin/wake-agent, a symlink to this file, so it follows its own links
# to find the mod folder, as spotlight's bin does. Node: the one on PATH, else
# Homebrew's.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
mod=$(cd "$(dirname "$self")/.." && pwd -P) || exit 1
node=$(command -v node 2>/dev/null)
if [ -z "$node" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$candidate" ]; then
      node=$candidate
      break
    fi
  done
fi
if [ -z "$node" ]; then
  echo "wake-agent: node not found (PATH, /opt/homebrew/bin, /usr/local/bin)" >&2
  exit 127
fi
exec "$node" "$mod/bin/wake-agent.mjs" "$@"
